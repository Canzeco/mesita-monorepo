# them itself, `deno task worktree add` and .cursor/worktrees.json do the same. Syntax = gitignore.
# Without these, app builds / the supabase CLI / local secrets are missing in fresh worktrees.
apps/*/.env
apps/*/.env.*
supabase/.env
supabase/.env.*
!supabase/.env.twilio.local.example
supabase/supabase/.temp/
