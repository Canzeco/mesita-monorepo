# OS / editor junk
.DS_Store

# safety nets — each package's own .gitignore is the real authority
node_modules/
.pnpm-store/

# local-only agent config
.claude/settings.local.json

# agent worktrees parked inside the repo
.worktrees/
.gstack/

# gstack runtime links (install script symlinks these into the committed
# .cursor/skills/gstack/ tree so skill preambles' GSTACK_ROOT resolves bins;
# never commit absolute VM/Mac symlinks)
.cursor/skills/gstack/bin
.cursor/skills/gstack/browse
.cursor/skills/gstack/review
.cursor/skills/gstack/gstack-upgrade
.cursor/skills/gstack/ETHOS.md
.cursor/skills/gstack/design
.cursor/skills/gstack/VERSION
