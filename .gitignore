# OS / editor junk
.DS_Store

# safety nets — each package's own .gitignore is the real authority
node_modules/
.pnpm-store/
# env files carry secrets: ignored here too, so one stays untracked even where no package
# .gitignore covers it (.worktreeinclude seeds them into every worktree)
.env
.env.*
!.env.example
!.env.*.example

# local-only agent config (and the copy Redeye takes before it arms)
.claude/settings.local.json
.claude/.redeye-backup.json

# gstack's per-repo scratch
.gstack/

# the Claude Code desktop app's launch worktrees: never tracked, seeded from .worktreeinclude
.claude/worktrees/
