# Supabase — the client calls Edge Functions, which in turn call Google Places
# and the database. The Google Places API key lives as the Supabase secret
# `google_places_api_key` and is never exposed in the browser bundle.
#
# Both NEXT_PUBLIC_* vars below are safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://yjalywfzdelacdzccpgb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS. Never expose to the browser. Used by the admin
# Supabase client in server actions / route handlers / Edge Functions when
# performing back-office writes (e.g. admin creating a venue). Grab it from
# Supabase Dashboard → Project Settings → API → `service_role` (or
# `secret_key` in newer projects).
SUPABASE_SECRET_KEY=

# Optional override: forces /api/places/* (and the Edge-Function helpers) into
# canned mock-data mode for offline UI development. Leave unset in production.
NEXT_PUBLIC_PLACES_MOCK=

# Google Maps JavaScript API key for the browser. Different from the
# server-side `GMP_KEY` Supabase secret — this one ships
# in the JS bundle and must be restricted by HTTP referrer to your domain
# (Google Cloud Console → APIs & Services → Credentials → restrict key).
# Required only on the /guest/discover/map surface.
NEXT_PUBLIC_GMP_KEY=
