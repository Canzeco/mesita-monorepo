{
  "name": "mesita-mobile-consumer",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.1.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.x",
      "onFail": "download"
    }
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm export",
    "lint": "expo lint --max-warnings 0 && node lint/check-fixture.mjs",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "test": "jest && node --test scripts/release-order.test.mjs",
    "export": "node scripts/with-env.mjs production expo export --platform ios --platform android",
    "start": "node scripts/with-env.mjs development expo start --dev-client",
    "sim": "pnpm dlx eas-cli@27.11.0 simulator:start --no-force --type agent-device --max-idle-time-minutes 15 --non-interactive",
    "shot": "node lint/shot.mjs",
    "step-end": "node scripts/step-end.mjs",
    "screens": "pnpm dlx eas-cli@27.11.0 workflow:run .eas/workflows/screens.yml --wait --non-interactive"
  },
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "@sentry/react-native": "~8.28.1",
    "@shopify/flash-list": "2.3.2",
    "@stripe/stripe-react-native": "0.81.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-persist-client": "^5.108.4",
    "aes-js": "^3.1.2",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lint/",
      "/scripts/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|standard-navigation|@shopify/flash-list))"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/teardown.ts"
    ]
  }
}
