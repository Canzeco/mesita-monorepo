# Copy to .env — these are the public (publishable) Mesita Supabase values,
# same key type the web apps use. All data access goes through Edge Functions;
# there is no service key here, ever.
EXPO_PUBLIC_SUPABASE_URL=https://yjalywfzdelacdzccpgb.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_bQPhz9pZSTnVAW1aOZ6Q6g_imiiwTJd

# Optional — Google Maps SDK (iOS + Android). Prefer platform-restricted keys
# for com.mesita.consumer (separate from the server google_places_api_key).
# Empty → Search map shows a branded placeholder; suggest/rail/add still work.
# EXPO_PUBLIC_GMP_KEY=

# Optional — Sentry crash reporting. Empty → Sentry.init skipped.
# Create the project in Sentry, then set the DSN (and SENTRY_AUTH_TOKEN on EAS
# for source-map upload).
# EXPO_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=canzeco
# SENTRY_PROJECT=mesita-mobile-consumer
