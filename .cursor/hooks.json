{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "bash scripts/preflight.sh cursor",
        "timeout": 20,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "bash scripts/preflight.sh cursor",
        "matcher": "Write|Delete|Shell",
        "timeout": 20,
        "failClosed": true
      }
    ]
  }
}
