{
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1"
  },
  "tasks": {
    "sync-rules": "deno run --allow-read --allow-write --allow-run=git scripts/sync-rules.ts",
    "sync-rules:check": "deno run --allow-read --allow-run=git scripts/sync-rules.ts --check",
    "test:rules": "deno test --allow-read scripts/sync-rules.test.ts",
    "sync-brand": "deno run --allow-read --allow-write scripts/sync-brand.ts",
    "sync-brand:check": "deno run --allow-read scripts/sync-brand.ts --check",
    "sync-shared": "deno run --allow-read --allow-write scripts/sync-shared.ts",
    "sync-shared:check": "deno run --allow-read scripts/sync-shared.ts --check",
    "test:shared": "deno test --allow-read scripts/sync-shared.test.ts",
    "boot": "deno run --allow-read --allow-write --allow-run=git,gh,bash --allow-env=HOME,CLAUDE_CODE_REMOTE,CLAUDE_CODE_REMOTE_SESSION_ID,MESITA_PLATFORM,MESITA_SESSION --allow-sys=hostname scripts/worktree.ts boot",
    "worktree": "deno run --allow-read --allow-write --allow-run=git,gh,bash --allow-env=HOME,CLAUDE_CODE_REMOTE,CLAUDE_CODE_REMOTE_SESSION_ID,MESITA_PLATFORM,MESITA_SESSION --allow-sys=hostname scripts/worktree.ts",
    "test:worktree": "deno test --allow-read --allow-write --allow-run=git,bash --allow-env=HOME,TMPDIR --allow-sys=hostname scripts/worktree.test.ts"
  }
}
