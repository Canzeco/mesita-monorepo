{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "Skill",
      "mcp__Linear",
      "mcp__github",
      "mcp__Notion",
      "mcp__Supabase",
      "mcp__Vercel",
      "mcp__Render",
      "mcp__ElevenLabs",
      "mcp__Twilio",
      "mcp__Claude_Docs",
      "mcp__claude-code-remote"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/preflight.sh\" session-start",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/preflight.sh\" claude",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/redeye-hook.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
